rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Helpers
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // User Profile Validation
    function isValidUser(data) {
      return data.keys().hasAll(['email']) &&
             data.email is string && data.email.size() <= 100;
    }

    // Saved Analysis Validation
    function isValidAnalysis(data) {
      return data.keys().hasAll(['userId', 'title', 'reportData', 'savedAt']) &&
             data.userId == request.auth.uid &&
             data.title is string && data.title.size() <= 300 &&
             data.savedAt is string;
    }

    // Saved Neutral Article Validation
    function isValidArticle(data) {
      return data.keys().hasAll(['userId', 'title', 'content', 'savedAt']) &&
             data.userId == request.auth.uid &&
             data.title is string && data.title.size() <= 300 &&
             data.content is string && data.content.size() <= 50000 &&
             data.savedAt is string;
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidUser(incoming());
      
      match /saved_analyses/{analysisId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidAnalysis(incoming()) && isValidId(analysisId);
        allow update: if isOwner(userId) && isValidAnalysis(incoming()) && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'reportData']);
        allow delete: if isOwner(userId);
      }

      match /saved_neutral_articles/{articleId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidArticle(incoming()) && isValidId(articleId);
        allow update: if isOwner(userId) && isValidArticle(incoming()) && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'content', 'level']);
        allow delete: if isOwner(userId);
      }
    }
  }
}
